{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "headerText": "Project SIS - Fullstack Python Backend, PostgreSQL & Next.js Frontend",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "copyToClipboard": false
  },
  "include": [
    "backend/app/**/*",
    "backend/scripts/**/*",
    "backend/tests/**/*",
    "backend/Dockerfile",
    "backend/requirements.txt",
    "database/init/**/*",
    "database/tools/*.py",
    "database/dataset_bersih/profil_sekolah.json",
    "frontend/src/**/*",
    "frontend/Dockerfile",
    "frontend/.dockerignore",
    "frontend/next.config.js",
    "frontend/package.json",
    "frontend/postcss.config.js",
    "frontend/tailwind.config.js",
    "frontend/tsconfig.json",
    ".env.example",
    ".gitignore",
    "docker-compose.yml",
    "README.md",
    "PANDUAN_MENJALANKAN*",
    "run.bat",
    "setup.bat"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/.env",
      "**/.env.*",
      "!**/.env.example",
      "backend/seed_output/seed_credentials.txt",
      "database/dataset_bersih/**/*.csv",
      "database/tools/LAPORAN_DAN_KAMU*",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/.pytest_cache/**",
      "**/.venv/**",
      "**/venv/**",
      "frontend/.next/**",
      "frontend/node_modules/**",
      "frontend/package-lock.json",
      "frontend/next-env.d.ts",
      "frontend/tsconfig.tsbuildinfo",
      "package-lock.json",
      "repomix-output.xml",
      "repomix.config.json",
      "struktur.txt"
    ]
  }
}
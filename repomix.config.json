{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": true,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "topFilesLength": 20,
    "headerText": "RigForge PC Builder Shop — Full-Stack Laravel 12 + React 19 SPA Codebase context for AI development, debugging, and code review."
  },
  "include": [
    "app/**/*",
    "bootstrap/app.php",
    "bootstrap/providers.php",
    "config/app.php",
    "config/auth.php",
    "config/database.php",
    "config/services.php",
    "database/migrations/**/*",
    "database/seeders/**/*",
    "database/factories/**/*",
    "routes/**/*",
    "resources/js/**/*",
    "resources/css/**/*",
    "resources/views/**/*",
    "PROJECT.md",
    "composer.json",
    "package.json",
    "vite.config.js",
    "phpunit.xml",
    ".env.example", 
    "setup.bat", 
    "run.bat", 
    ".env",
    "docker-compose.yml"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "vendor/**",
      "node_modules/**",
      "composer.lock",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "public/build/**",
      "public/storage/**",
      "public/hot",
      "public/**",
      "storage/**",
      "tests/**",
      "README.md",
      "AGENTS.md",
      "TEST_INFRA.md",
      "config/logging.php",
      "config/cache.php",
      "config/mail.php",
      "config/queue.php",
      "config/session.php",
      "config/filesystems.php",
      ".phpunit.result.cache",
      ".phpunit.cache/**",
      "resources/js/assets/images/**",
      "*.avif",
      "*.webp",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.svg",
      "*.ico",
      "*.woff",
      "*.woff2",
      "*.ttf",
      "*.eot",
      "database/*.sqlite*",
      "*.sqlite",
      "*.sqlite-wal",
      "*.sqlite-shm",
      ".agents/**",
      ".claude/**",
      ".cursor/**",
      ".gemini/**",
      ".idea/**",
      ".vscode/**",
      "repomix-output.*"
    ]
  }
}
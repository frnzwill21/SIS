# Salin menjadi .env lalu isi. Jangan commit .env.

# --- Database (dipakai Docker dan jalur manual) ---
POSTGRES_USER=sis
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-kuat
POSTGRES_DB=sis

# --- Backend ---
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=

# --- Hanya jalur manual (tanpa Docker): backend membaca ini ---
# DATABASE_URL=postgresql+psycopg://sis:ganti-dengan-kata-sandi-kuat@localhost:5432/sis

# Opsional
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SEND_DATA=0

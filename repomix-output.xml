def norm_gelar(n):
    n = re.sub(r'\s+', ' ', n.strip()); n = re.sub(r',\s*', ', ', n)
    n = n.replace('M. Pd.', 'M.Pd.')
    n = re.sub(r'(,\s*Gr)$', ', Gr.', n).replace('Gr..', 'Gr.')
    n = re.sub(r'M\.M$', 'M.M.', n)
    return n
